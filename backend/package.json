    "resend": "^2.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "drizzle-kit": "^0.20.10",
    "tsx": "^4.7.0",
