{
  "name": "textbook-backend",
  "version": "1.0.0",
  "description": "Backend API for AI-Native Textbook",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate:pg",
